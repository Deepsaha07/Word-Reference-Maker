<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">

  <Id>2366514C-4D30-4385-889D-41E2FB35DDEA</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Research Reboot</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName DefaultValue="WordReff - BibTeX paste &amp; cite"/>
  <Description DefaultValue="Paste BibTeX, add notes, insert citations, and auto-build a bibliography."/>

  <IconUrl DefaultValue="https://deepsaha07.github.io/Word-Reference-Maker/assets/icon-32-v2.png"/>
  <HighResolutionIconUrl DefaultValue="https://deepsaha07.github.io/Word-Reference-Maker/assets/icon-64-v2.png"/>

  <SupportUrl DefaultValue="https://deepsaha07.github.io/Word-Reference-Maker/support.html"/>

  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://deepsaha07.github.io/Word-Reference-Maker/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="grpWordReff">
                <Label resid="residGroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="icon16"/>
                  <bt:Image size="32" resid="icon32"/>
                  <bt:Image size="80" resid="icon80"/>
                </Icon>

                <Control xsi:type="Button" id="btnShowPane">
                  <Label resid="residButtonLabel"/>
                  <Supertip>
                    <Title resid="residButtonLabel"/>
                    <Description resid="residButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16"/>
                    <bt:Image size="32" resid="icon32"/>
                    <bt:Image size="80" resid="icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="residTaskPaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://deepsaha07.github.io/Word-Reference-Maker/assets/icon-16-v2.png"/>
        <bt:Image id="icon32" DefaultValue="https://deepsaha07.github.io/Word-Reference-Maker/assets/icon-32-v2.png"/>
        <bt:Image id="icon80" DefaultValue="https://deepsaha07.github.io/Word-Reference-Maker/assets/icon-80-v2.png"/>
      </bt:Images>

      <bt:Urls>
        <bt:Url id="residTaskPaneUrl" DefaultValue="https://deepsaha07.github.io/Word-Reference-Maker/taskpane.html"/>
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="residGroupLabel" DefaultValue="WordReff"/>
        <bt:String id="residButtonLabel" DefaultValue="Open WordReff"/>
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="residButtonTip" DefaultValue="Open the WordReff task pane."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>